# 공공데이터포털에서 발급받은 인증키 (일반 인증키 - Decoding 쪽 값)
# 이 파일을 복사해서 .env 로 이름을 바꾸고 실제 키를 넣으세요.
# .env 는 .gitignore 에 등록되어 있어 GitHub 에 올라가지 않습니다.
MSDS_SERVICE_KEY=여기에_디코딩된_인증키를_붙여넣기

# ---- 6차시: Supabase (DB) ----
# 이 파일을 복사해 .env.local 로 만들고 본인 프로젝트의 값을 넣으세요.
# (Supabase > Project Settings > API 에서 확인)
# 비워 두면 data/ 폴더의 예시 파일을 읽습니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
